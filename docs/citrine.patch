+
+    /// nxym 登录系统: 未认证玩家只保留 transport acknowledgements 和认证命令
+    /// (`register` / `login` / `changepassword`)，其余（移动、破坏、交互、普通聊天、
+    /// 其它命令）全部丢弃。这样玩家被"冻结"在出生点，直到完成认证。
+    pub(crate) fn keep_auth_packets(&mut self, i: usize, events: &mut Vec<HostEvent>) {
+        let enabled = crate::accounts::enabled();
+        let inbox = std::mem::take(&mut self.guests[i].inbox);
+        let mut bytes = 0;
+        for (packet, size) in inbox {
+            let keep = match &packet {
+                // Plain chat is kept so handle_chat can recognise bare `register`/`login`
+                // text; take the messages the client says it has seen, in order.
+                S::Chat(c) => {
+                    self.apply_last_seen(i, &c.last_seen, events);
+                    true
+                }
+                // A signed command is allowed only when it is an authentication command.
+                S::ChatCommandSigned(c) => {
+                    self.apply_last_seen(i, &c.last_seen, events);
+                    !enabled || crate::accounts::is_auth_command(&c.command)
+                }
+                S::ChatCommand(c) => {
+                    !enabled || crate::accounts::is_auth_command(&c.command)
+                }
+                S::ChatAck(c) => {
+                    self.chat_ack(i, c.offset, events);
+                    true
+                }
+                S::AcceptTeleportation(_)
+                | S::PlayerLoaded(_)
+                | S::ChunkBatchReceived(_)
+                | S::ClientInformation(_)
+                | S::ClientTickEnd(_)
+                | S::KeepAlive(_)
+                | S::Pong(_)
+                | S::PingRequest(_)
+                | S::ChatSessionUpdate(_) => true,
+                _ => false,
+            };
+            if keep {
+                bytes += size;
+                self.guests[i].inbox.push_back((packet, size));
+            }
+        }
+        self.guests[i].inbox_bytes = bytes;
+    }
 }
