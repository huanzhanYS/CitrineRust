+/// 去掉 `§` 颜色码，用于插件消息打印到控制台。
+#[cfg(feature = "nxym-plugin")]
+fn strip_legacy(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut chars = s.chars();
+    while let Some(c) = chars.next() {
+        if c == '§' {
+            chars.next();
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
